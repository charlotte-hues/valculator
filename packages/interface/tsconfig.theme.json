{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/theme-types",
    "rootDir": "../theme/src"
  },
  "include": ["../theme/src"],
  "exclude": ["../theme/src/vite-env.d.ts"]
}
